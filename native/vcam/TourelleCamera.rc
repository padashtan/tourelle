#include <winver.h>
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TOURELLE_VERSION_MAJOR, TOURELLE_VERSION_MINOR, TOURELLE_VERSION_PATCH, 0
 PRODUCTVERSION TOURELLE_VERSION_MAJOR, TOURELLE_VERSION_MINOR, TOURELLE_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Tourelle contributors"
            VALUE "FileDescription", "Tourelle Camera source (Windows Camera Frame Server)"
            VALUE "FileVersion", TOURELLE_VERSION_TEXT
            VALUE "InternalName", "TourelleCamera"
            VALUE "LegalCopyright", TOURELLE_COPYRIGHT
            VALUE "OriginalFilename", "TourelleCamera.dll"
            VALUE "ProductName", "Tourelle"
            VALUE "ProductVersion", TOURELLE_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
