#include <winver.h>
#include "Version.h"

1 ICON "tourelle.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TOURELLE_VERSION_MAJOR, TOURELLE_VERSION_MINOR, TOURELLE_VERSION_PATCH, 0
 PRODUCTVERSION TOURELLE_VERSION_MAJOR, TOURELLE_VERSION_MINOR, TOURELLE_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Tourelle contributors"
            VALUE "FileDescription", "Tourelle - live pan/tilt for a motorized webcam"
            VALUE "FileVersion", TOURELLE_VERSION_TEXT
            VALUE "InternalName", "Tourelle"
            VALUE "LegalCopyright", TOURELLE_COPYRIGHT
            VALUE "OriginalFilename", "Tourelle.exe"
            VALUE "ProductName", "Tourelle"
            VALUE "ProductVersion", TOURELLE_VERSION_TEXT
            VALUE "Comments", "Independent project, not affiliated with Logitech. https://github.com/padashtan/tourelle"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
